<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Rumbo.Movil.Vistas.MetasPagina"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:modelos="clr-namespace:Rumbo.Movil.ModelosVista"
    Title="Metas">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="16" RowSpacing="12">

        <!--
            Formulario de alta, plegado por defecto. Crear una meta se hace de vez en
            cuando; consultarla y aportar, mucho mas a menudo.
        -->
        <Border Grid.Row="0" Padding="12" StrokeShape="RoundRectangle 12" IsVisible="{Binding MostrandoFormulario}">
            <VerticalStackLayout Spacing="8">

                <Entry Placeholder="¿Para qué ahorras?" Text="{Binding NombreNueva, Mode=TwoWay}" />

                <Entry
                    Placeholder="¿Cuánto quieres reunir?"
                    Keyboard="Numeric"
                    Text="{Binding ObjetivoNueva, Mode=TwoWay}" />

                <Picker
                    Title="Prioridad"
                    ItemsSource="{Binding Prioridades}"
                    SelectedItem="{Binding PrioridadNueva, Mode=TwoWay}" />

                <Picker
                    Title="¿En qué cuenta se acumula?"
                    ItemsSource="{Binding Cuentas}"
                    ItemDisplayBinding="{Binding Nombre}"
                    SelectedItem="{Binding CuentaVinculada, Mode=TwoWay}" />

                <!--
                    La fecha es OPCIONAL. Sin ella no hay ritmo que calcular, y eso es
                    correcto: un fondo de emergencia no tiene plazo, un viaje si.
                -->
                <HorizontalStackLayout Spacing="8">
                    <Switch IsToggled="{Binding ConFecha, Mode=TwoWay}" />
                    <Label Text="Tiene fecha límite" VerticalOptions="Center" FontSize="13" />
                </HorizontalStackLayout>

                <DatePicker Date="{Binding FechaObjetivo, Mode=TwoWay}" IsVisible="{Binding ConFecha}" />

                <Button Text="Crear meta" Command="{Binding CrearComando}" />

            </VerticalStackLayout>
        </Border>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Metas}"
            SelectionMode="Single"
            SelectedItem="{Binding MetaSeleccionada, Mode=TwoWay}">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="modelos:MetaEnLista">
                    <VerticalStackLayout Padding="4,10" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding Nombre}" FontSize="15" />

                            <!--
                                El aviso de retraso va con texto, no solo con color. Una
                                meta que no llega a tiempo es justo lo que hay que poder
                                leer de un vistazo.
                            -->
                            <Label
                                Grid.Column="1"
                                Text="Va atrasada"
                                FontSize="12"
                                TextColor="#B3261E"
                                IsVisible="{Binding VaAtrasada}" />
                        </Grid>

                        <ProgressBar Progress="{Binding Fraccion}" />

                        <Label Text="{Binding Progreso}" FontSize="12" />
                        <Label Text="{Binding Ritmo}" FontSize="12" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label
                    Text="Todavía no hay metas de ahorro."
                    HorizontalTextAlignment="Center"
                    Margin="24" />
            </CollectionView.EmptyView>
        </CollectionView>

        <!--
            El formulario de aporte solo aparece al elegir una meta. Aportar mueve dinero de
            verdad, asi que exige elegir explicitamente a donde va y de donde sale: Rumbo
            nunca transfiere por su cuenta.
        -->
        <Border Grid.Row="2" Padding="12" StrokeShape="RoundRectangle 12" IsVisible="{Binding HayMetaSeleccionada}">
            <VerticalStackLayout Spacing="8">

                <Label Text="Aportar a esta meta" FontAttributes="Bold" FontSize="14" />

                <Entry
                    Placeholder="¿Cuánto aportas?"
                    Keyboard="Numeric"
                    Text="{Binding MontoAporte, Mode=TwoWay}" />

                <Picker
                    Title="Desde qué cuenta"
                    ItemsSource="{Binding Cuentas}"
                    ItemDisplayBinding="{Binding Nombre}"
                    SelectedItem="{Binding CuentaOrigen, Mode=TwoWay}" />

                <Button Text="Aportar" Command="{Binding AportarComando}" />

                <Label
                    Text="El aporte es una transferencia a la cuenta de ahorro de la meta, no un gasto."
                    FontSize="11" />

                <ActivityIndicator
                    IsVisible="{Binding EstaCargando}"
                    IsRunning="{Binding EstaCargando}"
                    HorizontalOptions="Center" />

                <Label
                    Text="{Binding MensajeError}"
                    IsVisible="{Binding HayError}"
                    TextColor="#B3261E"
                    FontSize="13" />

            </VerticalStackLayout>
        </Border>

        <Button
            Grid.Row="3"
            Text="Nueva meta"
            Command="{Binding AlternarFormularioComando}" />

    </Grid>

</ContentPage>
