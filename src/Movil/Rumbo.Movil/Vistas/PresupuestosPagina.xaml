<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Rumbo.Movil.Vistas.PresupuestosPagina"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:modelos="clr-namespace:Rumbo.Movil.ModelosVista"
    Title="Presupuesto">

    <RefreshView Command="{Binding CargarComando}" IsRefreshing="{Binding EstaCargando}">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16" RowSpacing="12">

            <Border Grid.Row="0" Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Titulo}" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding Resumen}" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Label
                Grid.Row="1"
                Text="{Binding MensajeError}"
                IsVisible="{Binding HayError}"
                TextColor="#B3261E" />

            <!--
                Anadir una partida crea el presupuesto del mes si todavia no existe. Son un
                solo boton a proposito: pedir primero «crear presupuesto» y luego «anadir
                partida» serian dos pasos para algo que la persona vive como uno.
            -->
            <Border Grid.Row="2" Padding="12" StrokeShape="RoundRectangle 12" IsVisible="{Binding MostrandoFormulario}">
                <VerticalStackLayout Spacing="8">

                    <Picker
                        Title="Categoría"
                        ItemsSource="{Binding Categorias}"
                        ItemDisplayBinding="{Binding Nombre}"
                        SelectedItem="{Binding CategoriaNueva, Mode=TwoWay}" />

                    <Entry
                        Placeholder="¿Cuánto quieres gastar como máximo?"
                        Keyboard="Numeric"
                        Text="{Binding MontoNueva, Mode=TwoWay}" />

                    <Button Text="Añadir partida" Command="{Binding AnadirPartidaComando}" />

                    <ActivityIndicator
                        IsVisible="{Binding EstaCargando}"
                        IsRunning="{Binding EstaCargando}"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Border>

            <CollectionView Grid.Row="3" ItemsSource="{Binding Partidas}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="modelos:PartidaEnLista">
                        <VerticalStackLayout Padding="4,10" Spacing="4">
                            <Label Text="{Binding Categoria}" FontSize="15" />

                            <!--
                                ProgressBar va de 0 a 1. El color lo decide el modelo de
                                vista segun el nivel, y SIEMPRE acompana al texto: quien no
                                distingue el rojo del verde sigue leyendo "Excedido".
                            -->
                            <ProgressBar Progress="{Binding Consumido}" ProgressColor="{Binding Color}" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding Cifras}" FontSize="12" />
                                <Label Grid.Column="1" Text="{Binding TextoNivel}" FontSize="12" TextColor="{Binding Color}" />
                            </Grid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label
                        Text="No hay un presupuesto vigente para este mes."
                        HorizontalTextAlignment="Center"
                        Margin="24" />
                </CollectionView.EmptyView>
            </CollectionView>

            <Button
                Grid.Row="4"
                Text="Añadir partida"
                Command="{Binding AlternarFormularioComando}" />

        </Grid>
    </RefreshView>

</ContentPage>
