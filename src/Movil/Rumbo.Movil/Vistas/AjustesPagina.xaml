<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Rumbo.Movil.Vistas.AjustesPagina"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Ajustes">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Border Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding NombreUsuario}" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding CorreoUsuario}" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Hogar activo" FontSize="14" FontAttributes="Bold" />

            <Picker
                ItemsSource="{Binding Espacios}"
                ItemDisplayBinding="{Binding Nombre}"
                SelectedItem="{Binding EspacioSeleccionado, Mode=TwoWay}" />

            <Label
                Text="Cambiar de hogar pide un permiso nuevo al servidor: no es un ajuste de este teléfono."
                FontSize="11" />

            <Label
                Text="{Binding AvisoVersion}"
                IsVisible="{Binding HayAvisoVersion}"
                FontSize="13"
                TextColor="#B58900" />

            <ActivityIndicator
                IsVisible="{Binding EstaCargando}"
                IsRunning="{Binding EstaCargando}"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding MensajeError}"
                IsVisible="{Binding HayError}"
                TextColor="#B3261E" />

            <Button Text="Cerrar sesión" Command="{Binding CerrarSesionComando}" Margin="0,16,0,0" />

            <Label Text="{Binding VersionInstalada, StringFormat='Rumbo {0}'}" FontSize="11" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
