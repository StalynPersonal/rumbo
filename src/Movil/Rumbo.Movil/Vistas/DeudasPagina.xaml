<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Rumbo.Movil.Vistas.DeudasPagina"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:modelos="clr-namespace:Rumbo.Movil.ModelosVista"
    Title="Deudas">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="16" RowSpacing="12">

        <!-- Formulario de alta, plegado. -->
        <Border Grid.Row="0" Padding="12" StrokeShape="RoundRectangle 12" IsVisible="{Binding MostrandoFormulario}">
            <VerticalStackLayout Spacing="8">

                <Entry Placeholder="¿Qué deuda es?" Text="{Binding NombreNueva, Mode=TwoWay}" />

                <Picker
                    Title="Tipo"
                    ItemsSource="{Binding TiposDeDeuda}"
                    SelectedItem="{Binding TipoNueva, Mode=TwoWay}" />

                <Entry
                    Placeholder="¿Cuánto pediste prestado?"
                    Keyboard="Numeric"
                    Text="{Binding OriginalNueva, Mode=TwoWay}" />

                <Entry
                    Placeholder="¿Cuánto te queda por pagar?"
                    Keyboard="Numeric"
                    Text="{Binding PendienteNueva, Mode=TwoWay}" />

                <Entry
                    Placeholder="Cuota mensual (opcional)"
                    Keyboard="Numeric"
                    Text="{Binding CuotaNueva, Mode=TwoWay}" />

                <Label
                    Text="Con la cuota se estima cuántos meses quedan. Sin ella no se estima nada."
                    FontSize="11" />

                <Button Text="Crear deuda" Command="{Binding CrearComando}" />

            </VerticalStackLayout>
        </Border>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Deudas}"
            SelectionMode="Single"
            SelectedItem="{Binding DeudaSeleccionada, Mode=TwoWay}">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="modelos:DeudaEnLista">
                    <VerticalStackLayout Padding="4,10" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding Nombre}" FontSize="15" />
                            <Label Grid.Column="1" Text="{Binding Saldo}" FontSize="15" FontAttributes="Bold" />
                        </Grid>

                        <ProgressBar Progress="{Binding Fraccion}" />
                        <Label Text="{Binding Avance}" FontSize="12" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label
                    Text="No hay deudas registradas. Ojalá siga así."
                    HorizontalTextAlignment="Center"
                    Margin="24" />
            </CollectionView.EmptyView>
        </CollectionView>

        <!--
            Formulario de pago. Aparece al elegir una deuda.

            Se pide el capital y el interes POR SEPARADO porque solo el recibo del banco sabe
            como se reparte la cuota. Repartirlo por nuestra cuenta daria una cifra
            inventada, y el interes pagado es justo el numero que hace ver lo que cuesta de
            verdad una deuda.
        -->
        <Border Grid.Row="2" Padding="12" StrokeShape="RoundRectangle 12" IsVisible="{Binding HayDeudaSeleccionada}">
            <VerticalStackLayout Spacing="8">

                <Label Text="Registrar un pago" FontAttributes="Bold" FontSize="14" />

                <Entry
                    Placeholder="Capital (lo que baja la deuda)"
                    Keyboard="Numeric"
                    Text="{Binding Capital, Mode=TwoWay}" />

                <Entry
                    Placeholder="Interés (lo que se lleva el banco)"
                    Keyboard="Numeric"
                    Text="{Binding Interes, Mode=TwoWay}" />

                <Picker
                    Title="Desde qué cuenta"
                    ItemsSource="{Binding Cuentas}"
                    ItemDisplayBinding="{Binding Nombre}"
                    SelectedItem="{Binding CuentaOrigen, Mode=TwoWay}" />

                <Picker
                    Title="Categoría del gasto"
                    ItemsSource="{Binding Categorias}"
                    ItemDisplayBinding="{Binding Nombre}"
                    SelectedItem="{Binding CategoriaPago, Mode=TwoWay}" />

                <Button Text="Registrar pago" Command="{Binding PagarComando}" />

                <Label
                    Text="Un pago de deuda SÍ es un gasto: el dinero sale de la cuenta y no aparece en ningún otro sitio."
                    FontSize="11" />

                <ActivityIndicator
                    IsVisible="{Binding EstaCargando}"
                    IsRunning="{Binding EstaCargando}"
                    HorizontalOptions="Center" />

                <Label
                    Text="{Binding MensajeError}"
                    IsVisible="{Binding HayError}"
                    TextColor="#B3261E"
                    FontSize="13" />

            </VerticalStackLayout>
        </Border>

        <Button
            Grid.Row="3"
            Text="Nueva deuda"
            Command="{Binding AlternarFormularioComando}" />

    </Grid>

</ContentPage>
