<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Capa de APLICACION: casos de uso, servicios por modulo, validaciones y calculadoras.
    Depende del Dominio y de los Contratos. No sabe nada de EF Core ni de HTTP.
  -->

  <ItemGroup>
    <PackageReference Include="FluentValidation" />

    <!--
      EF Core (solo la biblioteca base, no el proveedor de SQL Server). Permite declarar
      IContextoRumbo con DbSet<T> y escribir consultas LINQ en los servicios de negocio.
      No ata la capa a ninguna base de datos concreta: el proveedor lo elige Infraestructura.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rumbo.Dominio\Rumbo.Dominio.csproj" />
    <ProjectReference Include="..\Rumbo.Contratos\Rumbo.Contratos.csproj" />
  </ItemGroup>

</Project>
